# 杜邦分析
figure, axes = plt.subplots(2,2)
axes[0, 0].plot(year, ROE.iloc[0, 1:].values[::-1], marker="o", label = "格力")
axes[0, 0].plot(year, ROE.iloc[1, 1:].values[::-1], marker="o", label = "美的")
axes[0, 0].set_title("ROE变化趋势")
axes[0, 0].set_xlabel("year")
axes[0, 0].set_ylabel("ROE(%)")
axes[0, 0].legend()
axes[0, 1].plot(year, dupont.iloc[0, 1:6].values[::-1], marker="o", label = "格力")
axes[0, 1].plot(year, dupont.iloc[1, 1:6].values[::-1], marker="o", label = "美的")
axes[0, 1].set_title("销售净利率变化趋势")
axes[0, 1].set_xlabel("year")
axes[0, 1].set_ylabel("净利率(%)")
axes[0, 1].legend()
axes[1, 0].plot(year, dupont.iloc[0,6:11].values[::-1], marker="o", label="格力")
axes[1, 0].plot(year, dupont.iloc[1,6:11].values[::-1], marker="o", label="美的")
axes[1, 0].set_title("资产周转率变化趋势")
