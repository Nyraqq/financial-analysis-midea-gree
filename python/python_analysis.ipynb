import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

# 资产负债率
data = sqlite3.connect(r"C:\Users\21805\Desktop\财报分析.db")
debt = pd.read_sql("SELECT * FROM debt_ratio_by_year", data)
year = ["2021", "2022", "2023", "2024", "2025"]
plt.rcParams['font.sans-serif']=['SimHei']
plt.rcParams['axes.unicode_minus']=False
plt.plot(year, debt.iloc[0, 1:].values[::-1], marker="o", label = "格力")
plt.plot(year, debt.iloc[1, 1:].values[::-1], marker="o", label = "美的")
plt.title("2021-2025资产负债率变化趋势对比")
plt.xlabel("year")
plt.ylabel("debt ratio(%)")
plt.legend()
plt.savefig("资产负债率.png", dpi=150, bbox_inches="tight")
plt.show()  

