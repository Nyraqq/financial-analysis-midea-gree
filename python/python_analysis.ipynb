axes[1, 0].legend()
axes[1, 1].plot(year, dupont.iloc[0,11:].values[::-1], marker="o", label="格力")
axes[1, 1].plot(year, dupont.iloc[1,11:].values[::-1], marker="o", label="美的")
axes[1, 1].set_title("权益乘数变化趋势")
axes[1, 1].set_xlabel("year")
axes[1, 1].set_ylabel("权益乘数")
axes[1, 1].legend()
plt.tight_layout()
plt.savefig("杜邦分析四视图.png", dpi=150, bbox_inches="tight")
plt.show()  
